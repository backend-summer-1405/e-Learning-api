generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum Role {
  USER
  TEACHER
  ADMIN
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum ReactableType {
  NEWS
  COURSE
  PODCAST
}

enum RatableType {
  NEWS
  COURSE
  PODCAST
}

enum CommentableType {
  NEWS
  COURSE
  PODCAST
}

enum CommentReactionType {
  LIKE
  DISLIKE
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  WITHDRAW
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PodcastStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  COMMENT_REPLY
  COMMENT_LIKE
  COMMENT_APPROVED
  COMMENT_REJECTED
  COURSE_ENROLLED
  COURSE_APPROVED
  COURSE_REJECTED
  PODCAST_APPROVED
  PODCAST_REJECTED
  WALLET_TOPUP
  WALLET_WITHDRAW
  PURCHASE
  RATING
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(USER)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeAccountId String?  @unique
  activeAccount   Account? @relation("ActiveAccount", fields: [activeAccountId], references: [id], onDelete: SetNull)

  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
  reactions           Reaction[]
  comments            Comment[]
  commentReactions    CommentReaction[]

  courses     Course[]            @relation("TeacherCourses")
  enrollments Enrollment[]
  payments    Payment[]
  wallet      Wallet?
  withdrawals WithdrawalRequest[]
  ratings     Rating[]

  podcasts        Podcast[]         @relation("TeacherPodcasts")
  podcastProgress PodcastProgress[]
  podcastPlays    PodcastPlay[]

  notifications Notification[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForUser User?          @relation("ActiveAccount")
  images        AccountImage[]

  @@index([userId])
}

model AccountImage {
  id        String   @id @default(uuid())
  url       String
  isPrimary Boolean  @default(false)
  accountId String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, isPrimary])
}

model Reaction {
  id         String        @id @default(uuid())
  userId     String
  targetId   String
  targetType ReactableType
  type       ReactionType
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

model Comment {
  id              String        @id @default(uuid())
  content         String
  userId          String
  status          CommentStatus @default(PENDING)
  rejectionReason String?

  parentId String?
  path     String  @default("")
  depth    Int     @default(0)

  targetId   String
  targetType CommentableType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Comment[] @relation("CommentReplies")

  reactions CommentReaction[]

  timestamp Int?

  @@index([targetType, targetId, status, createdAt])
  @@index([parentId, status, createdAt])
  @@index([userId])
  @@index([path])
  @@index([status])
}

model CommentReaction {
  id        String              @id @default(uuid())
  userId    String
  commentId String
  type      CommentReactionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId, type])
  @@index([userId])
}

model Rating {
  id         String      @id @default(uuid())
  userId     String
  targetId   String
  targetType RatableType
  score      Int // 1-5
  comment    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

model News {
  id        String      @id @default(uuid())
  title     String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  images    NewsImage[]

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
}

model NewsImage {
  id        String   @id @default(uuid())
  url       String
  newsId    String
  createdAt DateTime @default(now())

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
}

model Course {
  id              String       @id @default(uuid())
  title           String
  slug            String       @unique
  description     String
  price           Int          @default(0)
  isFree          Boolean      @default(true)
  status          CourseStatus @default(DRAFT)
  level           CourseLevel  @default(BEGINNER)
  language        String       @default("fa")
  thumbnailUrl    String?
  previewVideoUrl String?
  teacherId       String
  rejectionReason String?

  ratingAvg       Float @default(0)
  ratingCount     Int   @default(0)
  likeCount       Int   @default(0)
  dislikeCount    Int   @default(0)
  enrollmentCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User          @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Restrict)
  sections    Section[]
  images      CourseImage[]
  enrollments Enrollment[]

  @@index([status, createdAt])
  @@index([teacherId])
  @@index([slug])
  @@index([isFree, status])
  @@index([level, status])
  @@index([ratingAvg])
  @@index([enrollmentCount])
}

model Section {
  id       String @id @default(uuid())
  courseId String
  title    String
  order    Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id        String   @id @default(uuid())
  sectionId String
  title     String
  videoUrl  String
  duration  Int      @default(0)
  order     Int      @default(0)
  isFree    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([sectionId, order])
}

model CourseImage {
  id        String   @id @default(uuid())
  courseId  String
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, isPrimary])
  @@index([courseId, order])
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  progress   Int      @default(0)
  enrolledAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean  @default(false)
  lastPosition Int      @default(0)
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  amount    Int
  authority String?       @unique
  refId     String?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String                @id @default(uuid())
  walletId    String
  type        WalletTransactionType
  amount      Int
  description String?
  referenceId String?
  createdAt   DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model WithdrawalRequest {
  id        String           @id @default(uuid())
  userId    String
  amount    Int
  iban      String
  fullName  String
  status    WithdrawalStatus @default(PENDING)
  adminNote String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Podcast {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String
  audioUrl        String
  subtitleUrl     String?
  duration        Int           @default(0)
  thumbnailUrl    String?
  teacherId       String
  status          PodcastStatus @default(DRAFT)
  rejectionReason String?

  ratingAvg    Float @default(0)
  ratingCount  Int   @default(0)
  likeCount    Int   @default(0)
  dislikeCount Int   @default(0)
  playCount    Int   @default(0)
  commentCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher  User              @relation("TeacherPodcasts", fields: [teacherId], references: [id], onDelete: Restrict)
  progress PodcastProgress[]
  plays    PodcastPlay[]

  @@index([status, createdAt])
  @@index([teacherId])
  @@index([slug])
  @@index([playCount])
}

model PodcastProgress {
  id                String   @id @default(uuid())
  userId            String
  podcastId         String
  lastPosition      Int      @default(0)
  completedSegments Json?
  updatedAt         DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([userId])
  @@index([podcastId])
}

model PodcastPlay {
  id        String   @id @default(uuid())
  podcastId String
  userId    String?
  position  Int
  createdAt DateTime @default(now())

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([podcastId, createdAt])
  @@index([podcastId, position])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
